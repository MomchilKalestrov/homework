@model MVC.Models.Book

@{
    ViewData["Title"] = "Delete Book";
}

<div class="container mt-4">
    <h2 class="mb-4 text-danger">🗑️ Delete Book</h2>

    <div class="alert alert-warning">
        Are you sure you want to delete this book? This action cannot be undone.
    </div>

    <div class="card" style="max-width: 480px;">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-4">Title</dt>
                <dd class="col-sm-8">@Model.Title</dd>

                <dt class="col-sm-4">Author</dt>
                <dd class="col-sm-8">@Model.Author</dd>

                <dt class="col-sm-4">Year Published</dt>
                <dd class="col-sm-8">@Model.YearPublished</dd>
            </dl>
        </div>
    </div>

    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="mt-3">
        @Html.AntiForgeryToken()
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">🗑️ Yes, Delete</button>
            <a class="btn btn-secondary" asp-action="Details" asp-route-id="@Model.Id">↩ Cancel</a>
            <a class="btn btn-primary" asp-action="Index">📚 Back to List</a>
        </div>
    </form>
</div>
