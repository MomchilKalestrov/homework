@model MVC.Models.Book

@{
    ViewData["Title"] = "Book Details";
}

<div class="container mt-4">
    <h2 class="mb-4">🔍 Book Details</h2>

    <div class="card" style="max-width: 480px;">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-4">Title</dt>
                <dd class="col-sm-8">@Model.Title</dd>

                <dt class="col-sm-4">Author</dt>
                <dd class="col-sm-8">@Model.Author</dd>

                <dt class="col-sm-4">Year Published</dt>
                <dd class="col-sm-8">@Model.YearPublished</dd>
            </dl>
        </div>
    </div>

    <div class="d-flex gap-2 mt-4">
        <a class="btn btn-warning" asp-action="Edit" asp-route-id="@Model.Id">✏️ Edit</a>
        <a class="btn btn-danger" asp-action="Delete" asp-route-id="@Model.Id">🗑️ Delete</a>
        <a class="btn btn-primary" asp-action="Index">↩ Back to List</a>
    </div>
</div>
